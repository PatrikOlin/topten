defmodule TopTenWeb.ListLive.View do
  use TopTenWeb, :live_view
  alias TopTen.Lists

  @impl true
  def mount(%{"slug" => slug}, _session, socket) do
    case Lists.get_list_by_slug!(slug) do
      %{} = list ->
	{:ok,
	 socket
	 |> assign(:page_title, list.title)
	 |> assign(:list, list)
	}
    end
  end

  @impl true
  def handle_event("remove-list", %{"id" => id}, socket) do
    list = socket.assigns.list
    
    if list.id == String.to_integer(id) do
      case Lists.delete_top_ten_list(list) do
	{:ok, _} ->
	  {:noreply,
	   socket
	   |> put_flash(:info, "Lista stekt!")
	   |> redirect(to: ~p"/")
	  }

      {:error, _} ->
	{:noreply,
	 socket
	|> put_flash(:error, "Kunde inte ta bort listan.")
	|> redirect(to: ~p"/lists/#{list.slug}")
	}
      end
    else
      {:noreply,
       socket
       |> put_flash(:error, "Ogiltigt list-ID.")
       |> redirect(to: ~p"/")
      }
    end
  end

 @impl true
  def render(assigns) do
    ~H"""
    <div class="container flex flex-col items-center w-full mx-auto px-4 py-8">
      <h1 class="text-3xl font-bold mb-6"><%= @list.title %></h1>
      <div class="mb-8">
	<ol class="list-none flex flex-col gap-4 marker:text-lorange-100">
          <%= for item <- @list.items do %>
	  <li class="flex flex-row items-center gap-4 align-center font-semibold">
	    <span class="flex justify-center p-1 w-8 font-semibold rounded-full bg-lorange-100 color-stone-200"><%= item.position %></span>
	    <%= item.content %>
	  </li>
          <% end %>
	</ol>
      </div>
      <div class="flex flex-row gap-4">
	<a class="flex flex-row gap-2 font-semibold bg-lorange-100 hover:bg-lorange-80 text-white py-2 px-4 rounded" href={~p"/lists/#{@list.slug}/edit"}>
<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10" />
</svg>
	  Redigera listan
	</a>

	<button class="flex flex-row gap-2 font-semibold bg-lorange-100 hover:bg-lorange-80 text-white py-2 px-4 rounded" type="button" phx-click="remove-list" phx-value-id={@list.id} phx-disable-with="Tar bort...">
	  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
	    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
	  </svg>
	  Ta bort listan
	</button>
      </div>
    </div>
    """
  end
end
